#!/bin/sh
# Bring up one scenario: X, then i3, then clients, then tauler.
#
# Each step waits for the previous one to actually answer rather than sleeping.
# Everything here only *launches* the desktop — deciding it is ready to
# photograph is the harness's job, because "mapped" is not "painted".
set -eu

: "${SCENARIO:?SCENARIO must name a directory under /fixtures}"

FIXTURE="/fixtures/${SCENARIO}"
[ -d "$FIXTURE" ] || { echo "e2e: no such fixture: $FIXTURE" >&2; exit 1; }

LOGS="/out/${SCENARIO}"
mkdir -p "$LOGS"

# -noreset is load-bearing. Without it the server resets the moment its last
# client disconnects, and everything set up by a command that then exits — the
# X resources below, the primary output — is silently discarded. It comes back
# as a setting that "worked" (exit 0) and did nothing.
Xvfb "$DISPLAY" -screen 0 "$SCREEN" -dpi "$DPI" -noreset >"$LOGS/xvfb.log" 2>&1 &

# xdpyinfo is the cheapest "is the server answering" probe there is.
i=0
until xdpyinfo >/dev/null 2>&1; do
    i=$((i + 1))
    [ "$i" -lt 100 ] || { echo "e2e: X server never came up" >&2; exit 1; }
    sleep 0.1
done

# ─── Install the fixture's dotfiles ───────────────────────────────────────
#
# A fixture comes in one of two shapes.
#
# A *rice* is a dotfiles repo: a `home/` tree copied over $HOME wholesale, so
# `~/.config/tauler/layout.op.mdx` (or the legacy `layout.jsx` + `config.yaml`),
# `~/.config/i3/config`, `~/.Xresources` and `~/.local/bin` sit exactly where
# they would on a real machine. Everything the rice configures that tauler
# does not own — the window manager, the terminal, the notifier, the launcher
# — lives there rather than being smuggled in as command-line flags. The whole
# directory can be copied onto a real $HOME.
#
# A *contract scenario* is a bare `layout.op.mdx` — or, on the legacy path, a
# bare `layout.jsx` plus, optionally, `config.yaml` and `i3.config`. That shape
# is the point of those fixtures: they demonstrate that a tauler desktop needs
# one file. It keeps working either way.
#
# `cp -a` so the mode bits on ~/.local/bin survive; the bind mount is read-only
# from the fixture's side and $HOME is not, which is also why this copies rather
# than symlinks.
mkdir -p "$HOME/.config/tauler"
if [ -d "$FIXTURE/home" ]; then
    cp -a "$FIXTURE/home/." "$HOME/"
elif [ -f "$FIXTURE/layout.op.mdx" ]; then
    cp "$FIXTURE/layout.op.mdx" "$HOME/.config/tauler/layout.op.mdx"
else
    cp "$FIXTURE/layout.jsx" "$HOME/.config/tauler/layout.jsx"
    # An `&&` here would take the shell down with `set -e` whenever the fixture
    # has no config.yaml, which is most of them.
    if [ -f "$FIXTURE/config.yaml" ]; then
        cp "$FIXTURE/config.yaml" "$HOME/.config/tauler/config.yaml"
    fi
fi

[ -f "$HOME/.config/tauler/layout.op.mdx" ] || [ -f "$HOME/.config/tauler/layout.jsx" ] \
    || { echo "e2e: fixture $SCENARIO installed no layout file" >&2; exit 1; }

# Everything below is what a session's .xinitrc does before it execs a window
# manager: merge the user's X resources, state the DPI, name a primary output,
# paint the desktop.
#
# The fixture's resources go in first so that the DPI below wins over anything
# a rice happens to set — the harness owns the DPI and the rice does not.
#
# `-nocpp` because xrdb runs its input through the C preprocessor by default,
# and an apostrophe in a `!` comment then comes back as
# `warning: missing terminating ' character`. The resources still load, so it is
# noise rather than breakage — but it is noise on every run, and no rice here
# uses a cpp macro.
if [ -f "$HOME/.Xresources" ]; then
    xrdb -merge -nocpp "$HOME/.Xresources"
fi

# State the DPI rather than letting it be derived. Xvfb reports the screen's
# physical size in whole millimetres, so 1920x1080 at 96dpi comes back as
# 508x286mm, from which tauler recomputes 95.9dpi — a DPR of 1.0009, enough to
# round every panel a pixel larger than it was declared. Xft.dpi takes
# precedence over the physical dimensions, and a real session sets it.
printf 'Xft.dpi: %s\n' "$DPI" | xrdb -merge
xrdb -query | grep -q "^Xft.dpi" || { echo "e2e: Xft.dpi did not stick" >&2; exit 1; }

# Xvfb marks no output primary; tauler asks RandR for the primary one at startup
# and cannot start without it. Any display manager sets this.
xrandr --output "$(xrandr --query | awk '/ connected/ { print $1; exit }')" --primary
xrandr --query | grep -q " connected primary" \
    || { echo "e2e: no output could be made primary" >&2; exit 1; }

# A flat desktop colour: it makes an unpainted panel obvious rather than
# camouflaged against black.
xsetroot -solid "#181825"

# A scenario whose looks are the point needs settings the contract scenarios
# have no business carrying — inner gaps, a palette, hairline borders. A rice
# keeps them where i3 itself would look; an older fixture may drop an
# `i3.config` beside its layout; everything else gets the shared one.
I3_CONFIG=/usr/local/share/e2e/i3.config
if [ -f "$HOME/.config/i3/config" ]; then
    I3_CONFIG="$HOME/.config/i3/config"
elif [ -f "$FIXTURE/i3.config" ]; then
    I3_CONFIG="$FIXTURE/i3.config"
fi

i3 -c "$I3_CONFIG" >"$LOGS/i3.log" 2>&1 &

i=0
until i3-msg -t get_version >/dev/null 2>&1; do
    i=$((i + 1))
    [ "$i" -lt 100 ] || { echo "e2e: i3 never answered IPC" >&2; exit 1; }
    sleep 0.1
done

# Two managed clients, so the screenshot shows the reservation pushing real
# windows aside rather than an empty workspace.
#
# A fixture that needs something else — other clients, more than one workspace,
# an ordering — supplies its own. It runs at this point in the sequence, which
# is before tauler: a startup script that needs tauler must background its own
# wait rather than block here, or nothing will ever start it.
if [ -x "$FIXTURE/startup" ]; then
    "$FIXTURE/startup"
else
    e2e-client 1 &
    e2e-client 2 &
fi

# The a11y scenario needs a D-Bus session and the AT-SPI accessibility bus, so
# an AT can attach to tauler's tree. tauler's accesskit adapter connects lazily
# (ADR 0039), so this is free unless a probe attaches — nothing is built or
# pushed until one does. Every other scenario never starts either bus, keeping
# their environments byte-identical.
#
# The bus addresses are persisted so a probe spawned later by the harness (a
# separate exec with none of this environment) can find them.
if [ "${A11Y:-0}" = "1" ]; then
    eval "$(dbus-launch --sh-syntax)"
    eval "$(/usr/libexec/at-spi-bus-launcher --launch-immediately)"
    : > "$LOGS/a11y.env"
    printf 'export DBUS_SESSION_BUS_ADDRESS=%s\n' "$DBUS_SESSION_BUS_ADDRESS" >> "$LOGS/a11y.env"
    printf 'export AT_SPI_BUS_ADDRESS=%s\n' "$AT_SPI_BUS_ADDRESS" >> "$LOGS/a11y.env"
fi

# Deliberately launched with the same environment a real session gives it: the
# bug class this suite exists for is the one where a spawned child cannot find
# something the parent could.
tauler >"$LOGS/tauler.log" 2>&1 &

echo "e2e: desktop up"

# testcontainers keeps the container for as long as PID 1 lives.
exec tail -f /dev/null