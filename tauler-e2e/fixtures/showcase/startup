#!/bin/sh
# Populate the desktop for the showcase, in place of the default two xterms.
#
# The terminals are pseudo-transparent urxvts (see home/.Xresources), which
# read the root pixmap tauler publishes after blitting its <wallpaper> — a
# path nothing else exercises. That means the clients depend on tauler, which
# the entrypoint starts *after* this script, so the real work runs in the
# background, gated on the property actually appearing. Waiting here would
# deadlock: the entrypoint would never reach the line that starts tauler.
#
# The scenario waits for both clients before asserting anything about them.
set -eu

client() {
    workspace="$1"
    pane="$2"
    title="$3"

    i3-msg "workspace $workspace" >/dev/null 2>&1

    # e2e-urxvt owns starting the terminal and proving it actually got the
    # wallpaper: rxvt-unicode drops it intermittently when several start close
    # together, and one that dropped it looks like a perfectly normal terminal.
    #
    # Sequentially, and waited for: i3 places a window on whatever workspace is
    # focused when it maps, and tauler-i3 reports focused_windows in focus
    # order. Launching these concurrently makes both of those a race, and the
    # bar's workspace pills are what the screenshot is showing off.
    e2e-urxvt "$title" showcase-pane "$pane"
}

populate() {
    i=0
    until xprop -root _XROOTPMAP_ID 2>/dev/null | grep -qv "not found"; do
        i=$((i + 1))
        [ "$i" -lt 300 ] || { echo "e2e: tauler never published _XROOTPMAP_ID" >&2; break; }
        sleep 0.1
    done

    # Workspaces 1 and 3 exist only so the bar has more than one pill; what is
    # in them is never photographed.
    client 1 2 tauler-docs
    client 3 2 tauler-build
    client 2 1 fetch
    client 2 2 tree

    # Land on the workspace holding two windows: it is the one that shows i3's
    # inner gaps, and it puts the focused pill in the middle of the three.
    i3-msg "workspace 2" >/dev/null 2>&1
}

populate &
