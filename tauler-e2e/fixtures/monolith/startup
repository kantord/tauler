#!/bin/sh
# Populate the desktop for Monolith III.
#
# Four workspaces so the rail has four folios (I–IV), and two windows on the one
# we land on so i3's 14px inner gap is visible.
#
# Terminals are urxvt with -tr: they read _XROOTPMAP_ID and show the engraved
# wallpaper through their own background. tauler publishes that property after
# blitting its <wallpaper> into the root, so the clients depend on tauler, which
# the entrypoint starts *after* this script — hence the backgrounded `populate`
# gated on the property appearing. Blocking here would deadlock.
set -eu

BIN="$(dirname "$0")/bin"

FONT="xft:JetBrains Mono:pixelsize=14,xft:Symbols Nerd Font Mono:pixelsize=14"

client() {
    workspace="$1"
    pane="$2"
    title="$3"

    i3-msg "workspace $workspace" >/dev/null 2>&1

    # C.UTF-8 is built into glibc, so it needs no locale generation — without it
    # urxvt decodes the pane's box-drawing characters as Latin-1.
    LC_ALL=C.UTF-8 \
    urxvt \
        -tr -sh 30 \
        -fn "$FONT" \
        -fg "#E9E4DA" -bg "#221F2B" \
        -b 18 \
        +sb \
        -title "$title" \
        -e "$BIN/pane" "$pane" &

    # Sequentially, and waited for: i3 places a window on whatever workspace is
    # focused when it maps, so launching these concurrently is a race and the
    # rail's folios are what the screenshot is showing off.
    #
    # Ask i3, not the X server: a managed client is reparented into an i3 frame,
    # so `xwininfo -root -children` lists the frame and never the client.
    i=0
    while [ "$i" -lt 100 ]; do
        if i3-msg -t get_tree 2>/dev/null | grep -q "\"$title\""; then
            return 0
        fi
        i=$((i + 1))
        sleep 0.1
    done
    echo "e2e: client $title never mapped" >&2
    return 1
}

populate() {
    i=0
    until xprop -root _XROOTPMAP_ID 2>/dev/null | grep -qv "not found"; do
        i=$((i + 1))
        [ "$i" -lt 300 ] || { echo "e2e: tauler never published _XROOTPMAP_ID" >&2; break; }
        sleep 0.1
    done

    client 1 3 monolith-index
    client 3 3 monolith-proof
    client 4 3 monolith-galley
    client 2 1 plate
    client 2 2 index

    # Land on the workspace with two windows: it shows the inner gap, and it
    # puts the lit folio in the middle of the four.
    i3-msg "workspace 2" >/dev/null 2>&1
}

populate &
