#!/bin/sh
# Populate the desktop for Monolith III.
#
# Four workspaces so the rail has four folios (I–IV), and two windows on the one
# we land on so i3's 14px inner gap is visible.
#
# The terminals are configured in ~/.Xresources, not here — including the
# pseudo-transparency that lets them show the engraved wallpaper. That means they
# depend on tauler having published _XROOTPMAP_ID, and the entrypoint starts
# tauler *after* this script — hence the backgrounded `populate` gated on the
# property appearing. Blocking here would deadlock.
set -eu

client() {
    workspace="$1"
    pane="$2"
    title="$3"

    i3-msg "workspace $workspace" >/dev/null 2>&1

    # C.UTF-8 is built into glibc, so it needs no locale generation — without it
    # urxvt decodes the pane's box-drawing characters as Latin-1.
    # Styling is in ~/.Xresources, merged by the entrypoint. This says
    # only which window it is and what to run in it.
    LC_ALL=C.UTF-8 urxvt -title "$title" -e "monolith-pane" "$pane" &

    # Sequentially, and waited for: i3 places a window on whatever workspace is
    # focused when it maps, so launching these concurrently is a race and the
    # rail's folios are what the screenshot is showing off.
    #
    # Ask i3, not the X server: a managed client is reparented into an i3 frame,
    # so `xwininfo -root -children` lists the frame and never the client.
    i=0
    while [ "$i" -lt 100 ]; do
        if i3-msg -t get_tree 2>/dev/null | grep -q "\"$title\""; then
            return 0
        fi
        i=$((i + 1))
        sleep 0.1
    done
    echo "e2e: client $title never mapped" >&2
    return 1
}

populate() {
    i=0
    until xprop -root _XROOTPMAP_ID 2>/dev/null | grep -qv "not found"; do
        i=$((i + 1))
        [ "$i" -lt 300 ] || { echo "e2e: tauler never published _XROOTPMAP_ID" >&2; break; }
        sleep 0.1
    done

    client 1 3 monolith-index
    client 3 3 monolith-proof
    client 4 3 monolith-galley
    client 2 1 plate
    client 2 2 index

    # Land on the workspace with two windows: it shows the inner gap, and it
    # puts the lit folio in the middle of the four.
    i3-msg "workspace 2" >/dev/null 2>&1

    comparison_surfaces
}

# The two surfaces tauler does not own, running for real alongside tauler's own
# versions of them, so the screenshot is a comparison rather than a claim.
#
# Both need a session bus that nothing else in this image provides, so this
# script starts one and exports it — dunst and dunstify are both children of
# this script, so nothing else has to know about it.
comparison_surfaces() {
    DBUS_SESSION_BUS_ADDRESS="$(dbus-daemon --session --fork --print-address)"
    export DBUS_SESSION_BUS_ADDRESS

    dunst -config "$HOME/.config/dunst/dunstrc" &

    # dunst has to own the name on the bus before a notification will reach it.
    i=0
    until dunstctl is-paused >/dev/null 2>&1; do
        i=$((i + 1))
        [ "$i" -lt 100 ] || { echo "e2e: dunst never came up" >&2; break; }
        sleep 0.1
    done

    # dunstify, not notify-send: libnotify-bin is not installed and dunst ships
    # its own sender.
    dunstify "Plate cycle complete" "4 surfaces reseeded from palette hash" \
        >/dev/null 2>&1 || true

    # rofi in dmenu mode with a fixed list, rather than `-show drun`: the entry
    # list then comes from this file instead of from whatever .desktop files the
    # base image happens to carry, so two runs photograph the same.
    printf 'plate-cycle\nplate-regen\nfolio-index\ngalley-replay\n' \
        | rofi -dmenu -p RUN -mesg "4 entries · seed 8f3c1a" \
               -theme "$HOME/.config/rofi/monolith.rasi" \
               >/dev/null 2>&1 &
}

populate &
