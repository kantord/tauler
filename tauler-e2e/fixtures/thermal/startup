#!/bin/sh
# Populate the desktop for Thermal.
#
# Three windows on the photographed workspace, tiled, all pseudo-transparent.
# Three rather than two on purpose: two windows lining up into one image could
# be a coincidence of two similar gradients, three across two split axes could
# not.
#
# -tr with -sh 100 means "no shading": the terminal paints the root pixmap at
# full strength, so the crop it shows is exactly the field's pixels and the
# seams across the 20px gaps are as good as they will ever get. Text legibility
# is then entirely down to the field being dark where the text sits, which is
# what the blob placement in layout.jsx is for.
set -eu

BIN="$(dirname "$0")/bin"

FONT="xft:JetBrains Mono:pixelsize=14,xft:Symbols Nerd Font Mono:pixelsize=14"

client() {
    workspace="$1"
    pane="$2"
    title="$3"

    i3-msg "workspace $workspace" >/dev/null 2>&1

    LC_ALL=C.UTF-8 \
    urxvt \
        -tr -sh 100 \
        -fn "$FONT" \
        -fg "#F1E7E2" -bg "#120F1C" \
        -b 18 \
        +sb \
        -title "$title" \
        -e "$BIN/pane" "$pane" &

    i=0
    while [ "$i" -lt 100 ]; do
        if i3-msg -t get_tree 2>/dev/null | grep -q "\"$title\""; then
            return 0
        fi
        i=$((i + 1))
        sleep 0.1
    done
    echo "e2e: client $title never mapped" >&2
    return 1
}

populate() {
    i=0
    until xprop -root _XROOTPMAP_ID 2>/dev/null | grep -qv "not found"; do
        i=$((i + 1))
        [ "$i" -lt 300 ] || { echo "e2e: tauler never published _XROOTPMAP_ID" >&2; break; }
        sleep 0.1
    done

    client 1 3 thermal-idle
    client 2 1 field
    client 2 2 seams
    client 2 3 probe

    i3-msg "workspace 2" >/dev/null 2>&1

    # Three columns, not three rows. i3 picks a split orientation from the
    # container's aspect ratio when a window maps, and on a 1844x1022 workspace
    # it picks vertical — so the windows stack and there is no vertical seam to
    # look across. Setting the layout after they exist re-flows all three.
    i3-msg "layout splith" >/dev/null 2>&1

    # Focus the leftmost, so the callout lands on a known rect rather than on
    # whichever client mapped last.
    i3-msg "[title=\"field\"] focus" >/dev/null 2>&1
}

populate &
