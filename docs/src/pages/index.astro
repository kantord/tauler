---
// tauler landing page — the ultra-minimal cut of design option 21a, reduced
// to workspace 01. The page composes organisms with layout classes only;
// type, color, and chrome live in the component layers (see ADR 0030).
import '../styles/fonts.css'
import '../styles/global.css'
import '../styles/crt.css'
import Hero from '../components/organisms/Hero.astro'
import TopPanel from '../components/organisms/TopPanel.astro'
import Stage from '../components/organisms/Stage.astro'
import StatementFooter from '../components/organisms/StatementFooter.astro'
import ScrollZone from '../components/organisms/ScrollZone.astro'
import Label from '../components/text/Label.astro'
import Heading from '../components/text/Heading.astro'
import Body from '../components/text/Body.astro'
import CodeBlock from '../components/ui/CodeBlock.astro'
import CommandLine from '../components/ui/CommandLine.astro'
import Button from '../components/ui/Button.astro'
import GithubMark from '../components/ui/GithubMark.astro'
import SeamGroup from '../components/ui/SeamGroup.astro'
import FontPreloads from '../components/FontPreloads.astro'

// The zones below the hero screen scroll over the viewport-fixed
// wallpaper (see Stage.astro) and explain, one mechanism per zone, what
// tauler actually does: the layout file, where data comes from, the
// render model, screen layout, install. Each zone pairs the
// explanation with a code example, sides alternating. The examples are
// lifted from the docs pages they summarise, so a claim here is never
// ahead of what the docs (and the runtime) do.

const EXAMPLES = {
  layoutFile: `---
theme:
  mode: dark
fonts:
  primary: "Inter"
---
export default function render() {
  const time = useStringStream("/bin/sh",
    "while :; do date +%H:%M; sleep 1; done");

  return (
    <root>
      <panel anchor="top" height={32} width={ctx.screen_width}>
        <div class="flex h-full w-full items-center justify-end px-3">
          <span class="text-[13px] text-white">{time}</span>
        </div>
      </panel>
    </root>
  );
}`,

  streams: `// the latest stdout line, as a string
const time = useStringStream("/bin/sh",
  "while :; do date +%H:%M; sleep 1; done");

// the latest line, parsed as JSON
const load = useJSONStream("/bin/sh",
  "while :; do cut -d' ' -f1 /proc/loadavg; sleep 1; done");

// the last 60 lines, oldest first
const history = useJSONStream("/bin/sh", \`
  while :; do cut -d' ' -f1 /proc/loadavg; sleep 1; done |
    tauler-accumulate -n 60
\`) ?? [];`,

  renderModel: `export default function render() {
  const notifications =
    useJSONStream("~/.cargo/bin/tauler-notify")?.notifications ?? [];

  return (
    <root>
      <panel anchor="top" height={26} width={ctx.screen_width}>
        <Module bin="~/.cargo/bin/tauler-i3">
          {(data, events) => {
            // in scope here: no context, no prop drilling
            const unread = notifications.length > 0;
            return (
              <WorkspaceList
                workspaces={data?.workspaces}
                events={events}
                unread={unread}
              />
            );
          }}
        </Module>
      </panel>
    </root>
  );
}`,

  screenLayout: `<I3Layout module="~/.cargo/bin/tauler-i3">
  <Panel id="sidebar"   anchor="left"   size={272}>…</Panel>
  <Panel id="topbar"    anchor="top"    size={26}>…</Panel>
  <Panel id="bottombar" anchor="bottom" size={26}>…</Panel>
</I3Layout>

// gaps sent to tauler-i3, derived from the panels above:
// { left: 272, right: 0, top: 26, bottom: 26 }`,

  install: `# build dependencies on Debian/Ubuntu
sudo apt-get install -y libwayland-dev libxkbcommon-dev \\
  libfontconfig-dev libxcb1-dev pkg-config

cargo install tauler

# data sources, each its own crate
cargo install tauler-i3          # i3/sway workspaces
cargo install tauler-notify      # desktop notifications
cargo install tauler-accumulate  # history windows

tauler`,
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>tauler — declarative workspace customization</title>
    <meta
      name="description"
      content="Declare your Linux workspace — status bars, automations, smart-home controls, data dashboards — in one file, and tauler keeps reality matching it. Any program that prints data or takes commands can drive it."
    />
    <link rel="canonical" href={new URL('/', Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#16161d" />
    <meta property="og:title" content="tauler" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL('/', Astro.site)} />
    <meta
      property="og:description"
      content="Declare your workspace. tauler keeps it that way."
    />
    <meta name="twitter:card" content="summary" />
    <FontPreloads />
    <script is:inline>
      // Locks the tube to physical device pixels rather than nominal CSS
      // pixels, so zooming the page in or out doesn't change how coarse
      // the effect looks — a real CRT's scanline pitch and misconvergence
      // don't change when you lean closer to the glass.
      //
      // --crt-dpr is the raw devicePixelRatio; crt.css divides any size
      // that should read as "N device pixels" by it, so the on-screen
      // physical size stays constant while the CSS-px value shrinks as
      // the user zooms in (and grows as they zoom out) to compensate.
      //
      // --crt-scan-period is additionally snapped to a whole device pixel
      // count: an unsnapped period doesn't line up with the physical
      // pixel grid and the repeating gradient moirés into uneven banding
      // — see crt.css.
      ;(function () {
        var root = document.documentElement
        var TARGET_SCAN_DEVICE_PX = 3
        function align() {
          var dpr = window.devicePixelRatio || 1
          root.style.setProperty('--crt-dpr', String(dpr))
          // The period is a whole device-pixel count already (an integer
          // constant divided by dpr) — no rounding needed. Rounding
          // dpr-scaled inputs was the earlier bug: round(3 * dpr) grows
          // the target along with zoom instead of holding it constant,
          // so the pattern got physically thicker as the page zoomed in.
          root.style.setProperty(
            '--crt-scan-period',
            TARGET_SCAN_DEVICE_PX / dpr + 'px',
          )
        }
        align()
        addEventListener('resize', align)
      })()
    </script>
    <script>
      // Hidden CRT tuning panel — reachable only via `crt.tune()` in the
      // devtools console, never linked from the page. See crt-panel.ts.
      import { initCrtPanel } from '../scripts/crt-panel'
      initCrtPanel()
    </script>
  </head>
  <body>
    {
      /* The panel and the footer are sticky children of this full-page
         wrapper: the panel holds the viewport's top edge and the footer
         its bottom edge for the entire scroll, framing the zones, until
         the footer settles into its natural place at the very end. */
    }
    <div class="flex flex-col">
      <TopPanel />
      <Stage>
        <Hero />
      </Stage>
      {
        /* A named region, so the zones are inside a landmark (the hero's
           <main> ends with the stage); axe's region rule flags anything
           that isn't. */
      }
      <section aria-label="How tauler works" class="relative flex flex-col">
        <ScrollZone vh={1.2} side="right">
          <Label aboveFold={false}>01 · THE LAYOUT FILE</Label>
          <Heading>Describe your desktop environment in a single file</Heading>
          <Body aboveFold={false}>
            ~/.config/tauler/layout.op.mdx is a configuration file that contains
            a single render function. This is where you define the appearance
            and behavior of your desktop environment. Tauler knows when this
            layout file needs to be re-evaluated.
          </Body>
          <Body aboveFold={false}>
            Saving the file automatically updates behavior - no need to manually
            restart anything.
          </Body>
          <Body aboveFold={false}>
            Some configuration items such as fonts and the active theme are
            stored in the YAML frontmatter. Note that the syntax is JSX - but
            there is no Node, React or even a browser involved. Tauler's
            built-in UI rendering uses a lightweight rendering stack.
          </Body>
          <CodeBlock
            slot="example"
            path="~/.config/tauler/layout.op.mdx"
            code={EXAMPLES.layoutFile}
          />
        </ScrollZone>

        <ScrollZone vh={1.2} side="left">
          <Label aboveFold={false}>02 · DATA</Label>
          <Heading>Integrate with any application</Heading>
          <Body aboveFold={false}>
            Data streams can be sourced from simple shell scripts, or even from
            an application directly. Tauler relies on data streams to know when
            an update is required.
          </Body>
          <Body aboveFold={false}>
            From the perspective of your layout, this is a stateless data model:
            layouts are pure functions, and buffering the latest state of each
            of your streams is taken care of by Tauler's internals.
          </Body>
          <CodeBlock slot="example" code={EXAMPLES.streams} />
        </ScrollZone>

        <ScrollZone vh={1.2} side="right">
          <Label aboveFold={false}>03 · RENDERING</Label>
          <Heading>The whole layout is rendered again on every change</Heading>
          <Body aboveFold={false}>
            Whenever a data source prints a new line, Tauler runs your render
            function again from top to bottom and redraws what changed. Think of
            it as a spreadsheet rather than React: there is no component state,
            no effects and no lifecycle - just a function from the current data
            to what is on screen.
          </Body>
          <Body aboveFold={false}>
            Since all data is read at the top of the function, it is available
            everywhere below - including inside a Module's render callback.
            Combining two sources means using both variables. Note that state
            which needs to persist between renders, such as "there was a
            notification since you last looked", belongs in the program that
            produces the data, not in the layout.
          </Body>
          <CodeBlock
            slot="example"
            path="~/.config/tauler/layout.op.mdx"
            code={EXAMPLES.renderModel}
          />
        </ScrollZone>

        <ScrollZone vh={1.2} side="left">
          <Label aboveFold={false}>04 · SCREEN LAYOUT</Label>
          <Heading
            >Panels are windows. Reserving space for them is explicit.</Heading
          >
          <Body aboveFold={false}>
            A panel is a window that Tauler places itself, on the right output
            and at the right DPI. Note that creating a panel doesn't tell your
            window manager to keep other windows out of the way - and i3 can't
            reserve space for a left or right bar through struts at all.
          </Body>
          <Body aboveFold={false}>
            On i3 and sway, space is reserved through gaps instead. Wrap your
            panels in I3Layout and it derives the gaps from the panel sizes you
            already declared, then sends them to tauler-i3. There is no second
            set of numbers to keep in sync.
          </Body>
          <CodeBlock slot="example" code={EXAMPLES.screenLayout} />
        </ScrollZone>

        <ScrollZone vh={1.2} side="right">
          <Label aboveFold={false}>05 · INSTALL</Label>
          <Heading>Install with cargo</Heading>
          <Body aboveFold={false}>
            Tauler is a Rust program for Linux and runs on both X11 and Wayland
            - it picks the backend from WAYLAND_DISPLAY. Building it needs Rust
            1.95 or newer; running it needs fontconfig.
          </Body>
          <Body aboveFold={false}>
            Data sources like tauler-i3 (workspaces and gaps), tauler-notify (a
            notification daemon) and tauler-accumulate (history) are separate
            crates. Install the ones your layout uses, run tauler, and start
            editing the file.
          </Body>
          <CommandLine aboveFold={false}>cargo install tauler</CommandLine>
          <SeamGroup>
            <Button href="/docs/" variant="accent" aboveFold={false}
              >DOCS →</Button
            >
            <Button href="https://github.com/kantord/tauler" aboveFold={false}>
              <GithubMark />
              GITHUB
            </Button>
          </SeamGroup>
          <CodeBlock slot="example" lang="sh" code={EXAMPLES.install} />
        </ScrollZone>
      </section>
      <StatementFooter>
        One native binary renders your panels. Any script becomes a data source.
      </StatementFooter>
    </div>
    <div class="crt-halation" aria-hidden="true"></div>
    <div class="crt-scanlines" aria-hidden="true"></div>
    <div class="crt-vignette" aria-hidden="true"></div>
  </body>
</html>
