---
// tauler landing page — the ultra-minimal cut of design option 21a, reduced
// to workspace 01. The page composes organisms with layout classes only;
// type, color, and chrome live in the component layers (see ADR 0030).
import '../styles/fonts.css'
import '../styles/global.css'
import Hero from '../components/organisms/Hero.astro'
import PanelBar from '../components/organisms/PanelBar.astro'
import Stage from '../components/organisms/Stage.astro'
import StatementFooter from '../components/organisms/StatementFooter.astro'
import dmMono400 from '@fontsource/dm-mono/files/dm-mono-latin-400-normal.woff2?url'
import martianMono500 from '@fontsource/martian-mono/files/martian-mono-latin-500-normal.woff2?url'
import martianMono600 from '@fontsource/martian-mono/files/martian-mono-latin-600-normal.woff2?url'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>tauler</title>
    <meta
      name="description"
      content="A status bar for Linux whose layout is written as a .jsx file. The file returns a tree of panels; tauler renders it into X11 or Wayland windows."
    />
    <link
      rel="preload"
      href={martianMono500}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={martianMono600}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={dmMono400}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <div class="flex min-h-dvh flex-col">
      <PanelBar />
      <Stage>
        <Hero />
      </Stage>
      <StatementFooter>
        No component state, no effects, no lifecycle. Closer to a spreadsheet
        than to React.
      </StatementFooter>
    </div>
  </body>
</html>
