---
// tauler landing page — the ultra-minimal cut of design option 21a, reduced
// to workspace 01. The page composes organisms with layout classes only;
// type, color, and chrome live in the component layers (see ADR 0030).
import '../styles/fonts.css'
import '../styles/global.css'
import '../styles/crt.css'
import Hero from '../components/organisms/Hero.astro'
import TopPanel from '../components/organisms/TopPanel.astro'
import Stage from '../components/organisms/Stage.astro'
import StatementFooter from '../components/organisms/StatementFooter.astro'
import ScrollZone from '../components/organisms/ScrollZone.astro'
import Label from '../components/text/Label.astro'
import FontPreloads from '../components/FontPreloads.astro'

// Dummy scrollytelling zones below the hero screen — placeholders for the
// real narrative content, scrolling over the viewport-fixed wallpaper
// (see Stage.astro). Uneven heights on purpose: a zone's own length sets
// its own reading pace.
const ZONES = [
  { name: 'INTRO', vh: 0.8 },
  { name: 'SIGNAL', vh: 1.6 },
  { name: 'STRUCTURE', vh: 1.0 },
  { name: 'DEPTH', vh: 2.2 },
  { name: 'THRESHOLD', vh: 0.6 },
  { name: 'CLOSE', vh: 1.4 },
]
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>tauler — declarative workspace customization</title>
    <meta
      name="description"
      content="Declare your Linux workspace — status bars, automations, smart-home controls, data dashboards — in one file, and tauler keeps reality matching it. Any program that prints data or takes commands can drive it."
    />
    <link rel="canonical" href={new URL('/', Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#16161d" />
    <meta property="og:title" content="tauler" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL('/', Astro.site)} />
    <meta
      property="og:description"
      content="Declare your workspace. tauler keeps it that way."
    />
    <meta name="twitter:card" content="summary" />
    <FontPreloads />
    <script is:inline>
      // Locks the tube to physical device pixels rather than nominal CSS
      // pixels, so zooming the page in or out doesn't change how coarse
      // the effect looks — a real CRT's scanline pitch and misconvergence
      // don't change when you lean closer to the glass.
      //
      // --crt-dpr is the raw devicePixelRatio; crt.css divides any size
      // that should read as "N device pixels" by it, so the on-screen
      // physical size stays constant while the CSS-px value shrinks as
      // the user zooms in (and grows as they zoom out) to compensate.
      //
      // --crt-scan-period is additionally snapped to a whole device pixel
      // count: an unsnapped period doesn't line up with the physical
      // pixel grid and the repeating gradient moirés into uneven banding
      // — see crt.css.
      ;(function () {
        var root = document.documentElement
        var TARGET_SCAN_DEVICE_PX = 3
        function align() {
          var dpr = window.devicePixelRatio || 1
          root.style.setProperty('--crt-dpr', String(dpr))
          // The period is a whole device-pixel count already (an integer
          // constant divided by dpr) — no rounding needed. Rounding
          // dpr-scaled inputs was the earlier bug: round(3 * dpr) grows
          // the target along with zoom instead of holding it constant,
          // so the pattern got physically thicker as the page zoomed in.
          root.style.setProperty(
            '--crt-scan-period',
            TARGET_SCAN_DEVICE_PX / dpr + 'px',
          )
        }
        align()
        addEventListener('resize', align)
      })()
    </script>
    <script>
      // Hidden CRT tuning panel — reachable only via `crt.tune()` in the
      // devtools console, never linked from the page. See crt-panel.ts.
      import { initCrtPanel } from '../scripts/crt-panel'
      initCrtPanel()
    </script>
  </head>
  <body>
    {
      /* The panel and the footer are sticky children of this full-page
         wrapper: the panel holds the viewport's top edge and the footer
         its bottom edge for the entire scroll, framing the zones, until
         the footer settles into its natural place at the very end. */
    }
    <div class="flex flex-col">
      <TopPanel />
      <Stage>
        <Hero />
      </Stage>
      <div class="relative flex flex-col">
        {
          ZONES.map((z, i) => (
            <ScrollZone vh={z.vh}>
              <Label>
                {i + 1} / {ZONES.length} · {z.name} · {z.vh}×
              </Label>
            </ScrollZone>
          ))
        }
      </div>
      <StatementFooter>
        One native binary renders your panels. Any script becomes a data source.
      </StatementFooter>
    </div>
    <div class="crt-halation" aria-hidden="true"></div>
    <div class="crt-scanlines" aria-hidden="true"></div>
    <div class="crt-vignette" aria-hidden="true"></div>
  </body>
</html>
