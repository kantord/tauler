---
// The demo column: the layout.jsx panel and the schematic screen it
// produces, standing in beside the hero's type column wherever there's
// room for it. Hidden below xl — no design exists yet for showing both the
// hero copy and a 560px panel column without squeezing one of them past
// its own type ramp (see the demo handoff, "decisions you must not make
// alone" §14).
//
// It cycles through a few real tauler examples on its own — the same
// exception the workspace-scroll design made for its "reservation cycle"
// (the demo handoff's motion budget, §7): everywhere else nothing animates
// unless the user or real data moved it, but a demo whose whole point is
// "describe it once, tauler runs it live" says nothing if it never
// changes. Direct-access dots and a prefers-reduced-motion pause carry
// over from that same precedent.
//
// The cycle itself runs on a real browser Unit (`defineUnit`, ADR 0036) —
// the same wasm module and the same reconciler native tauler uses, not a
// second "looks like tauler" timer standing in for it. Which panel is
// declared changes on its own interval or a dot click; which panel is
// actually shown is the Unit converging to match, through its `update`
// hook.
import CodePanel from '../ui/CodePanel.astro'
import ScreenMock from '../ui/ScreenMock.astro'
import DemoDots from '../ui/DemoDots.astro'

const demoStates = [
  {
    id: 'load',
    label: 'SYSTEM METRICS',
    reload: 'panels: top(48) · surfaces bound',
    // Matches the sample's own `anchor="top"` — ScreenMock's preview reads
    // this rather than re-deriving it from the code string, so the two can
    // never say different things.
    anchor: 'top' as const,
    code: `const load = useStringStream("/bin/sh",
  "while :; do cut -d' ' -f1 /proc/loadavg; sleep 1; done");

<panel anchor="top" height={48} width={ctx.screen_width}>
  <div class="flex h-full items-center gap-3 px-5
              bg-card/70 text-foreground">
    <Chart data={load.window(16)} class="w-40" />
    <span class="ml-auto">load {load}</span>
  </div>
</panel>`,
  },
  {
    id: 'lights',
    label: 'SMART HOME',
    reload: 'panels: right(64) · surfaces bound',
    anchor: 'right' as const,
    code: `const kitchen = useHomeAssistant("light.kitchen");

<panel anchor="right" width={64} height={ctx.screen_height}>
  <div class="flex h-full flex-col items-center gap-4
              py-5 bg-card/70 text-foreground">
    <Toggle bind={kitchen.on} onChange={kitchen.set} />
    <span class="text-[10px]">{kitchen.on ? "ON" : "OFF"}</span>
  </div>
</panel>`,
  },
  {
    id: 'feed',
    label: 'LIVE DATA',
    reload: 'panels: left(320) · surfaces bound',
    anchor: 'left' as const,
    code: `const top = useJson(
  "https://hn.algolia.com/api/v1/search?tags=front_page");

<panel anchor="left" width={320} height={ctx.screen_height}>
  <div class="flex h-full flex-col gap-2 p-4
              bg-card/70 text-foreground">
    <List items={top.hits.slice(0, 5)} />
  </div>
</panel>`,
  },
]
---

<div
  data-reveal
  data-demo
  class="flex w-[560px] flex-col gap-s5 max-xl:hidden tight:gap-s4"
>
  <CodePanel
    path="~/.config/tauler/layout.jsx"
    states={demoStates}
    note="tauler:root-bg — THE FIELD BEHIND THIS PANEL IS THE SAME FIELD INSIDE IT."
  />
  <DemoDots states={demoStates} />
  <ScreenMock states={demoStates} />
</div>

<script>
  // Swaps which pre-rendered (build-time-highlighted) frame is visible,
  // in lockstep across CodePanel and ScreenMock's terminal — both just
  // mark their alternatives with the same data-demo-frame id. Direct
  // access via the dots is not just a convenience: it's also the
  // mechanism that satisfies "give the user a way to stop this" for
  // auto-advancing content, alongside the reduced-motion pause below.
  const root = document.querySelector<HTMLElement>('[data-demo]')
  const frames = root
    ? Array.from(root.querySelectorAll<HTMLElement>('[data-demo-frame]'))
    : []
  const dots = root
    ? Array.from(root.querySelectorAll<HTMLButtonElement>('[data-demo-dot]'))
    : []
  const label = root?.querySelector<HTMLElement>('[data-demo-label]')
  const ids = [
    ...new Set(
      dots
        .map((d) => d.dataset.stateId)
        .filter((id): id is string => Boolean(id)),
    ),
  ]

  function show(id: string): void {
    for (const frame of frames) frame.hidden = frame.dataset.demoFrame !== id
    for (const dot of dots) {
      if (dot.dataset.stateId === id) {
        dot.setAttribute('aria-current', 'true')
        if (label && dot.dataset.label) label.textContent = dot.dataset.label
      } else {
        dot.removeAttribute('aria-current')
      }
    }
  }

  // The server already rendered the first state (CodePanel's i===0 frame,
  // DemoDots' first aria-current) — there is nothing to converge until the
  // declared panel actually changes, so booting the wasm module costs
  // nothing visible even before it resolves.
  // `max-xl:hidden` (below) means most loads never show this column at all —
  // booting a ~1MB wasm module for a decorative widget nobody can see is the
  // one cost this page cannot excuse itself. `display` is what that utility
  // actually sets, so it's what's checked, not the breakpoint value itself.
  const columnVisible = root ? getComputedStyle(root).display !== 'none' : false

  if (root && ids.length > 1 && columnVisible) {
    let desiredIndex = 0
    // What the page currently shows — the Unit's own "observed world",
    // read back rather than assumed, the same rule native Units follow
    // (ADR 0035).
    let shownId = ids[0]

    async function driveWithRealUnit(): Promise<void> {
      // Both are served build products (see units.js's own header) living
      // in public/, not something Vite's own module graph owns — and
      // Vite refuses to import a public/ file at all ("can only be
      // referenced via <script src>"). Neither @vite-ignore nor hiding
      // the specifier behind a variable is enough to dodge that: Vite's
      // dev-server transform rewrites *any* `import(...)` expression it
      // sees in a file it processes (this script is one), appending its
      // own `?import` marker regardless of whether the target was
      // statically known — which then 500s the same way. The only
      // reliable way to keep an `import()` invisible to that AST-level
      // rewrite is to keep it out of the AST: `new Function` builds it
      // from a string Vite never parses, so both dev and build hand the
      // call to the browser's own native dynamic import, untouched. Its
      // return type is necessarily `any` — there is no module for astro
      // check to resolve either, the same gap `@ts-expect-error` filled
      // before this stopped being a literal `import()` at all.
      const dynamicImport = new Function(
        'specifier',
        'return import(specifier)',
      ) as (specifier: string) => Promise<any>
      const { boot } = await dynamicImport('/tauler/runtime.js')
      const { defineUnit } = await dynamicImport('/tauler/units.js')
      await boot('/tauler/tauler_web_bg.wasm')

      function converge(items: { id: string }[]): void {
        for (const item of items) {
          shownId = item.id
          show(item.id)
        }
      }

      const unit = defineUnit({
        key: () => 'demo-panel',
        value: (item: { id: string }) => item.id,
        items: () => [{ id: ids[desiredIndex] }],
        observe: () => [{ id: shownId }],
        enter: converge,
        update: (pairs: { item: { id: string } }[]) =>
          converge(pairs.map((p) => p.item)),
        // Every place `desiredIndex` changes — `advance` below, a dot click —
        // calls `unit.sweep()` itself the same tick, so nothing here needs to
        // poll to notice a change. This interval is only the safety net a
        // real Unit always keeps in case a caller forgets to, at native's own
        // default cadence — not the thing driving the cycle.
        refreshInterval: 5000,
      })

      const reduceMotion = matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches
      function advance(): void {
        desiredIndex = (desiredIndex + 1) % ids.length
        unit.sweep()
      }
      let timer: ReturnType<typeof setInterval> | undefined
      if (!reduceMotion) timer = setInterval(advance, 4500)

      for (const dot of dots) {
        dot.addEventListener('click', () => {
          const i = ids.indexOf(dot.dataset.stateId ?? '')
          if (i === -1) return
          desiredIndex = i
          unit.sweep()
          if (timer) {
            clearInterval(timer)
            timer = setInterval(advance, 4500)
          }
        })
      }
    }

    // No fallback timer on failure: the page stays on the server-rendered
    // first state rather than faking motion with something that isn't
    // tauler running it.
    driveWithRealUnit().catch((error: unknown) => {
      console.error('tauler: the browser Unit demo did not start', error)
    })
  }
</script>

<style>
  /* The one thing that moves on its own here beyond the demo cycle above:
     a single reveal on load, nothing ambient or looping (see
     tokens/effects.css's motion budget — --dur-reveal / --ease upstream).
     Reduced motion skips straight to the end state instead of disabling
     the property, since a hidden-until-JS element must still end up
     visible if the animation never plays. A data attribute, not a class,
     so this stays outside the Tailwind class-layer contract (see
     check-class-layers.ts). */
  [data-reveal] {
    animation: demo-column-reveal 620ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      animation-duration: 1ms;
    }
  }
  @keyframes demo-column-reveal {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
