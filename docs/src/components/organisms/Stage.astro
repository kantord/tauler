---
// The wallpaper surface. Owns the generative flow field: one canvas,
// drawn once, decorative, absent without JavaScript. The canvas is fixed
// to the viewport rather than scoped to this stage, so scrollytelling
// content below the hero scrolls over the same wallpaper.
import PageWidth from '../ui/PageWidth.astro'
---

{
  /* overflow-clip, not overflow-hidden: `hidden` establishes a scroll
     container, which would become the reference for the fade's view()
     timeline below — a scrollport that never scrolls, freezing the
     animation. `clip` clips the same content without becoming one. */
}
<main class="relative flex items-center overflow-clip bg-surface-wallpaper">
  <canvas
    id="field"
    class="fixed inset-0 h-dvh w-full bg-surface-wallpaper"
    aria-hidden="true"></canvas>
  <div class="crt-beam" aria-hidden="true"></div>
  <PageWidth><div data-stage-content><slot /></div></PageWidth>
</main>

<style>
  /* The hero screen is panel + stage + footer adding up to exactly one
     viewport. The page scrolls past the stage now (scrollytelling zones
     follow it), so `flex-1` can no longer size it — there is no fixed
     container to grow into — and the height is stated directly instead.
     A calc of theme tokens isn't a classifiable utility, so it lives
     here (same pattern as CodePanel's <style>). */
  main {
    min-height: calc(100dvh - var(--spacing-panel) - var(--spacing-footer));
  }

  /* The hero content fades out as it scrolls off toward the zones — the
     same scroll-driven fade the zones use (see ScrollZone.astro), on the
     content only: the wallpaper canvas and the sticky panel/footer stay
     fully opaque. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      [data-stage-content] {
        animation: stage-fade-out linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 70%;
      }
    }
  }

  @keyframes stage-fade-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
</style>

<script>
  import { drawField } from '../../scripts/field.ts'

  const canvas = document.getElementById('field') as HTMLCanvasElement
  const stage = canvas.parentElement as HTMLElement

  /* A panel over the field never blurs what it covers — it redraws the
     exact slice of the same field it sits on top of, offset by its own
     position in the stage, so the art lines up pixel-for-pixel with the
     wallpaper behind it. The slice canvas is the full stage-sized field
     copy, positioned with a negative offset inside its own
     overflow-hidden host so only the aligned sliver shows; that's what
     guarantees "exact slice" rather than an independently-drawn
     approximation. See CodePanel.astro / the demo handoff §6.

     The wallpaper canvas is viewport-fixed, so a panel's offset into it
     is simply the panel's viewport position — and it changes on every
     scroll, not just on resize. placeSlices() is the cheap style-only
     realignment run per scrolled frame; paintSlices() additionally
     re-copies the pixels and only runs when the field itself repaints. */
  function placeSlices(): void {
    for (const host of stage.querySelectorAll<HTMLElement>(
      '[data-slice-host]',
    )) {
      const slice = host.querySelector<HTMLCanvasElement>('[data-field-slice]')
      if (!slice) continue
      const hr = host.getBoundingClientRect()
      slice.style.width = canvas.clientWidth + 'px'
      slice.style.height = canvas.clientHeight + 'px'
      slice.style.left = -hr.left + 'px'
      slice.style.top = -hr.top + 'px'
    }
  }
  function paintSlices(): void {
    for (const host of stage.querySelectorAll<HTMLElement>(
      '[data-slice-host]',
    )) {
      const slice = host.querySelector<HTMLCanvasElement>('[data-field-slice]')
      if (!slice) continue
      slice.width = canvas.width
      slice.height = canvas.height
      const sctx = slice.getContext('2d')
      if (sctx) sctx.drawImage(canvas, 0, 0)
    }
    placeSlices()
  }

  /* Draw once; repaint only on width change, debounced ≥200ms
     (height-only changes are ignored — mobile browser chrome).
     The design mandates a 2× backing store — hairline art aliases at 1× —
     but 2× of a 4K viewport is a ~125MB canvas, so the scale backs off
     just enough to cap the store at ~48MB on very large screens. */
  let lastW = 0
  function paint(): void {
    const w = canvas.clientWidth
    if (w === lastW) return
    lastW = w
    const h = canvas.clientHeight
    const scale = Math.min(2, Math.sqrt(12_000_000 / (w * h)))
    canvas.width = Math.round(w * scale)
    canvas.height = Math.round(h * scale)
    // Hex because the canvas parses it into RGB; the token (--color-accent)
    // is oklch, which parseInt can't read. Keep in sync with global.css.
    drawField(canvas, 'flow', '#F0855A', 0, scale)
    paintSlices()
  }
  /* Off the critical path: first paint waits for a frame so LCP text
     renders before ~90K line segments hit the main thread. */
  requestAnimationFrame(paint)
  let t: ReturnType<typeof setTimeout>
  addEventListener('resize', () => {
    clearTimeout(t)
    t = setTimeout(paint, 200)
  })
  /* Keep the panel slices glued to the fixed wallpaper while the page
     scrolls under them — style writes only, one per rendered frame. */
  let placing = false
  addEventListener(
    'scroll',
    () => {
      if (placing) return
      placing = true
      requestAnimationFrame(() => {
        placing = false
        placeSlices()
      })
    },
    { passive: true },
  )
</script>
