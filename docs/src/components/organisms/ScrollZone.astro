---
// One scrollytelling zone: a full-bleed section over the viewport-fixed
// wallpaper (see Stage.astro) whose content fades in over the bottom
// third of the viewport and out over the top third. The fade tracks the
// CONTENT's own view timeline, not the zone's — a tall zone's entry/exit
// ranges complete while its centered content is still off-screen, which
// made content pop in already opaque. Pure CSS scroll-driven animation,
// no scroll listeners; browsers without scroll-timeline support (and
// readers who prefer reduced motion) just see the content, always
// visible.
interface Props {
  /** Zone height as a multiple of the viewport height. */
  vh: number
}

const { vh } = Astro.props
---

<section
  data-zone
  style={`min-height:${vh * 100}vh`}
  class="relative flex flex-col items-center justify-center"
>
  <div data-zone-content class="flex flex-col items-center gap-s3">
    <div data-zone-fade class="flex flex-col items-center gap-s3">
      <slot />
    </div>
  </div>
</section>

<style>
  [data-zone-content] {
    view-timeline: --zone-pass;
  }

  /* One property, two ranges: two fill-both animations on the same
     element can't share `opacity` (the later one's fill masks the
     earlier), so the fade-in animates the outer element and the
     fade-out its inner wrapper — the opacities multiply instead of
     overriding. Both read the outer element's timeline (a named view
     timeline is visible to descendants, so no timeline-scope needed). */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      [data-zone-content] {
        animation: zone-fade-in linear both;
        animation-timeline: --zone-pass;
        animation-range: entry 0% cover 30%;
      }
      [data-zone-fade] {
        animation: zone-fade-out linear both;
        animation-timeline: --zone-pass;
        animation-range: cover 70% exit 100%;
      }
    }
  }

  @keyframes zone-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes zone-fade-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
</style>
