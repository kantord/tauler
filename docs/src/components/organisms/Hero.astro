---
// The hero row: the type column and, beside it, the file with its two
// renders (HeroDemo). Below lg the two stack, copy first, and the demo
// keeps rendering — it is images and markup, nothing that needs room for
// a runtime.
import HeroCopy from './HeroCopy.astro'
import HeroDemo from './HeroDemo.astro'
---

<div
  class="grid w-full grid-cols-[1fr_minmax(0,600px)] items-center gap-s8 max-lg:grid-cols-1"
>
  <HeroCopy />
  <HeroDemo />
</div>
