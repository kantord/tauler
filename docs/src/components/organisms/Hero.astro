---
// The hero row: the type column always, and — once there's room for both
// without squeezing the type ramp (see DemoColumn) — the demo column
// beside it. When DemoColumn hides itself, its grid track collapses to
// nothing and HeroCopy simply owns the row.
import HeroCopy from './HeroCopy.astro'
import DemoColumn from './DemoColumn.astro'
---

<div class="grid w-full grid-cols-[1fr_auto] items-center gap-s8">
  <HeroCopy />
  <DemoColumn />
</div>
