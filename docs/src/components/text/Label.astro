---
// Caps label — the machine-flavoured workhorse. Separator is always "·".
// No `uppercase` transform: caps are typed, so user-typed strings like
// `.jsx` keep their real casing (a design rule, not an accident).
//
// `aboveFold` marks the element for landing.spec.ts's first-viewport
// contract; zones below the fold reuse the same atom and opt out.
interface Props {
  aboveFold?: boolean
}

const { aboveFold = true } = Astro.props
---

<p class:list={['font-ui text-label text-ink-4', aboveFold && 'above-fold']}>
  <slot />
</p>
