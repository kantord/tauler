---
// Body copy, capped at the design's 42ch measure. `aboveFold` marks it
// for landing.spec.ts's first-viewport contract; zones below the fold
// reuse the same atom and opt out.
interface Props {
  aboveFold?: boolean
}

const { aboveFold = true } = Astro.props
---

<p
  class:list={[
    'max-w-measure font-ui text-body-md text-ink-2 short:text-body-sm',
    aboveFold && 'above-fold',
  ]}
>
  <slot />
</p>
