---
// A file on screen: path, the current example's name, and syntax-highlighted
// code. Sits over the wallpaper field and is opaque — DemoColumn redraws the
// exact field slice behind it (see
// data-slice-host / data-field-slice, painted by Stage's script) rather
// than blurring it, so the art lines up pixel-for-pixel with the wallpaper
// it covers. Highlighting is Shiki at build time via astro:components,
// the same engine Starlight's docs pages use for fenced code.
//
// Cycles through several examples — DemoColumn's script drives it via
// data-demo-frame, data-demo-prev/-next and data-demo-label; this
// component only pre-renders every state's highlighted HTML at build time
// and gives the script the hooks to swap which one is visible. There's no
// separate dot row for this any more — the chevrons here are the whole
// switcher, so nothing else on the page repeats what this bar already
// says.
import { Code } from 'astro:components'
import type { ComponentProps } from 'astro/types'
// Passed as a theme *object*, not the bundled-theme name string: Astro's
// <Code> resolves a named theme against its own compiled shiki theme
// registry, which (astro 7.2.4 + shiki 4.4.3, this lockfile) throws
// "Theme `github-dark` is not included in this bundle" for every preset
// name at build time even though the same lookup works outside Vite's SSR
// bundle — passing the theme's data directly bypasses that lookup. Same
// theme Starlight's Expressive Code uses for the docs' own fenced code.
import githubDark from 'shiki/themes/github-dark.mjs'

interface Props {
  path: string
  states: { id: string; label: string; code: string }[]
  lang?: ComponentProps<typeof Code>['lang']
}

const { path, states, lang = 'jsx' } = Astro.props
---

<div
  data-slice-host
  class="relative overflow-hidden border border-line-2 shadow-panel"
>
  <canvas data-field-slice class="absolute top-0 left-0" aria-hidden="true"
  ></canvas>
  <div class="absolute inset-0 bg-surface-frame/85"></div>
  <div class="relative">
    <div
      class="flex items-center gap-s3 border-b border-line-2 px-s4 py-s3 font-ui text-chrome-sm tracking-chrome text-ink-3"
    >
      <span>{path}</span>
      <div class="ml-auto flex items-center gap-s2">
        <button
          type="button"
          data-demo-prev
          aria-label="Show the previous example"
          data-demo-chevron
          class="cursor-pointer px-[2px] text-[13px] leading-none text-ink-4 transition hover:text-accent"
        >
          ◂
        </button>
        <span data-demo-label class="text-accent">{states[0]?.label}</span>
        <button
          type="button"
          data-demo-next
          aria-label="Show the next example"
          data-demo-chevron
          class="cursor-pointer px-[2px] text-[13px] leading-none text-ink-4 transition hover:text-accent"
        >
          ▸
        </button>
      </div>
    </div>
    {
      /* Every state's frame lives in the same grid cell (`col-start-1
         row-start-1` on each) rather than being toggled with `hidden`:
         `hidden` forces `display:none`, which drops an element from
         sizing entirely, so the container only ever reflected the
         *current* sample's height — a real jump every time the cycle
         moved to a shorter one. Stacking them and hiding all but the
         active one with `visibility:hidden` (the <style> block below —
         Tailwind's `invisible` utility isn't in this layer's allowed set,
         and `[grid-area:...]` isn't a recognized class either, so both
         live there instead) keeps every sample in the sizing calculation,
         so the grid row is always the tallest one's height, whichever is
         showing. */
    }
    <div data-code class="grid px-[18px] py-s5">
      {
        states.map((s, i) => (
          <div
            data-demo-frame={s.id}
            data-demo-inactive={i !== 0 ? '' : undefined}
            class="col-start-1 row-start-1"
          >
            <Code code={s.code} lang={lang} theme={githubDark} />
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  /* Plain text, not a button that happens to sit in JSX-shaped chrome:
     `appearance` isn't a Tailwind-classifiable surface/spacing/text
     utility (check-class-layers.ts rejects it as a class), and the
     browser's native <button> chrome (a visible background box, in
     Chromium) is exactly what "just use regular chevrons" ruled out. */
  [data-demo-chevron] {
    appearance: none;
    border: 0;
    background: transparent;
  }

  /* See the comment above this element in the markup: kept in the grid's
     sizing calculation on purpose, just not painted. */
  [data-demo-frame][data-demo-inactive] {
    visibility: hidden;
  }

  /* astro:components' <Code> inlines its own background/font/line-height
     on the <pre> it emits; only !important can outrank an inline style. */
  [data-code] :global(pre.astro-code) {
    margin: 0;
    padding: 0;
    overflow: auto;
    background: transparent !important;
    font-family: var(--font-ui) !important;
    font-size: 13.5px !important;
    line-height: 1.72 !important;
  }
</style>
