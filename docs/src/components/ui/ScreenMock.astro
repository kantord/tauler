---
// A schematic screenshot of what layout.jsx (in CodePanel above it)
// produces: bezel, workspace buttons, two terminals and a browser window
// tiled edge to edge — proof a tiled workspace isn't just one terminal.
// It depicts a screen — it is not an interface, so it carries no
// focusable content and is hidden from assistive tech entirely; the code
// that produces it is what's readable.
//
// The workspace-button strip up top isn't a simulated i3bar — it's what
// this whole page is arguing for: tauler replaces i3bar/polybar, so that
// strip is drawn exactly like the three cycling examples below it would
// draw one, not a separate "here's what a status bar looks like" bit.
//
// Every tiled pane below it is `border`, nothing else — no title bar, no
// on-screen "FOCUSED" label, no highlighted pane. Checked against a real
// i3 config's own `for_window [all] border pixel 1`: focus there is a
// border color, but this mock skips even that — which window has input
// isn't the story being told here, so nothing claims one does.
//
// The terminal's last two lines track CodePanel's cycling states
// (data-demo-frame, driven by DemoColumn's script) so the reload log
// always matches whichever example is on screen. The panel-position strip
// below the header does too — the one thing this mock previously got wrong:
// the *code* changed but nothing showed the *panel* actually moving, which
// is exactly the claim the page is making. Only the active anchor's edge is
// reserved, same as a real tiling WM only reflows the tiled area where a
// bar actually sits — DemoColumn's script sets [data-gap-root]'s
// data-active-anchor from the entering strip's own data-anchor, and the
// padding transition below does the rest.
//
// Secondary text here is ink-3, not the usual ink-4: at this scale (10.5–
// 11.5px, well under the "large text" AA threshold) ink-4 on surface-frame
// measures ~4.46:1 — just under WCAG AA's 4.5:1 floor for small text.
import PanelPositionStrip from './PanelPositionStrip.astro'

interface Props {
  states: { id: string; reload: string; anchor: 'top' | 'right' | 'left' }[]
}

const { states } = Astro.props

// A real 1920×1080 page rendered at this pane's true size would be a few
// hundred px wide — its text would be a couple of pixels tall, not a
// legible sentence. Greeked bars, not real headlines: this is a
// screenshot, not a webpage you're meant to read. Widths are fixed (not
// random) so the build — and its visual-regression baseline — stays
// deterministic. The same goes for the URL bar: if the page's own text
// doesn't get to be readable, the address bar doesn't either — it's one
// more greeked bar, not a smaller font.
const feedRows = [
  { title: 82, meta: 32 },
  { title: 64, meta: 44 },
  { title: 90, meta: 28 },
  { title: 58, meta: 50 },
  { title: 75, meta: 34 },
  { title: 68, meta: 40 },
]

const tabs = [
  { active: false, title: 26 },
  { active: true, title: 30 },
  { active: false, title: 22 },
]

// i3bar's own workspace buttons (see draw_button/draw_bars in i3bar's
// xcb.c): a bordered box per workspace, three states — focused, active
// (visible on another output but not focused), inactive. One output only
// here, so "active" never applies.
const workspaces = [
  { number: 1, focused: true },
  { number: 2, focused: false },
  { number: 3, focused: false },
]

// The second terminal has nothing to say — it exists to prove tiling isn't
// one lucky terminal, the same job the browser's greeked feed rows already
// do. Widths fixed, not random, for the same determinism reason as
// feedRows above.
const fillerLines = [72, 45, 88, 30, 60, 50]
---

<div
  aria-hidden="true"
  data-screen
  data-active-anchor={states[0]?.anchor}
  class="flex flex-col gap-[5px] border border-line-2 bg-surface-frame p-[5px] font-ui shadow-panel"
>
  {
    /* The workspace/clock bar is a tauler panel too — the whole page's
       argument is that tauler renders bars, not just this one demo's
       three examples — so it isn't fixed chrome sitting above the cycle;
       it only shows when the active example actually declares a
       top-anchored panel (`load`, the only `anchor="top"` state). The
       other examples declare right/left panels instead, so there's
       nothing here for tauler to have rendered, and this stays blank —
       `visibility`, not `hidden`, so the row's own height never moves
       when it does. Driven by [data-screen]'s data-active-anchor, the
       same attribute the panel-position padding below already reads. */
  }
  <div
    data-top-bar
    class="flex items-center gap-[3px] border-b border-line-1 px-s2 pb-1"
  >
    {
      workspaces.map((ws) => (
        <span
          class:list={[
            'border px-[4px] py-[1px] text-label-sm tracking-chrome',
            ws.focused
              ? 'border-accent bg-accent text-accent-ink'
              : 'border-line-2 text-ink-3',
          ]}
        >
          {ws.number}
        </span>
      ))
    }
    <span class="ml-auto text-label-sm tracking-chrome text-ink-3" data-clock
      >--:--</span
    >
  </div>
  <div data-gap-root class="relative">
    {
      /* The panel the current code actually declares — real position,
         real widget shape, not a picture of one. Reuses the same
         data-demo-frame toggling DemoColumn's script already drives.
         PanelPositionStrip owns the shared wrapper/hidden-guard shell;
         only each anchor's own glyph shape lives here. The reserved edge
         itself is driven by data-active-anchor below, from CSS, not a
         permanent pt/pr/pl — see the <style> block for why.

         No `top` case: a top-anchored example already has the workspace
         bar above to show it declared something there. A second accent
         strip repeating that, right underneath, read as two top bars for
         the same panel — this mock draws it once. */
    }
    {
      states
        .filter((s) => s.anchor !== 'top')
        .map((s) => (
          // Always hidden on first paint: the default state (states[0]) is
          // the top-anchored one, filtered out above, so neither remaining
          // strip is ever the initial state — the client script takes over
          // from here once a cycle actually reaches one of them.
          <PanelPositionStrip id={s.id} hidden anchor={s.anchor}>
            {s.anchor === 'right' && (
              <>
                <span class="h-[6px] w-[6px] bg-accent-ink" />
                <span class="text-[5px] tracking-chrome text-accent-ink">
                  ON
                </span>
              </>
            )}
            {s.anchor === 'left' && (
              <>
                <span class="h-[2px] w-full bg-accent-ink/70" />
                <span class="h-[2px] w-[70%] bg-accent-ink/50" />
                <span class="h-[2px] w-[85%] bg-accent-ink/70" />
              </>
            )}
          </PanelPositionStrip>
        ))
    }
    {
      /* No title bars anywhere below — checked against a real i3 config's
         `for_window [all] border pixel 1`: every window is *just* a
         border, no decoration. No gaps between panes either (that config
         leaves `gaps inner`/`gaps outer` commented out), so panes sit edge
         to edge and each one's own border is the only seam. Every pane
         gets the same muted border — this mock isn't claiming to know
         which one has focus, only that a tiled screen holds more than one
         window at once. */
    }
    <div class="grid grid-cols-[2.6fr_1.4fr]">
      {
        /* Stacked top/bottom, not side by side — a horizontal split, one
           terminal above the other, sharing this column's width rather
           than each getting half of it. */
      }
      <div class="flex flex-col">
        <div class="flex flex-1 flex-col border border-line-2 bg-surface-frame">
          <div
            class="flex flex-col gap-s2 px-s3 py-s3 text-chrome-sm text-ink-2"
          >
            <p><span class="text-accent">❯</span> cargo run --release</p>
            <p class="text-ink-3">Compiling tauler</p>
            <p class="text-ink-3">Finished [optimized]</p>
            {
              states.map((s, i) => (
                <div data-demo-frame={s.id} hidden={i !== 0}>
                  <p>
                    <span class="text-accent">❯</span> tauler reload
                  </p>
                  <p class="text-ink-3">{s.reload}</p>
                </div>
              ))
            }
            <p><span class="text-accent">❯</span> _</p>
          </div>
        </div>
        <div class="flex flex-1 flex-col border border-line-2 bg-surface-frame">
          <div class="flex flex-col gap-s2 px-s3 py-s3">
            {
              fillerLines.map((w) => (
                <div class="h-[2px] bg-ink-4/40" style={`width:${w}%`} />
              ))
            }
          </div>
        </div>
      </div>
      <div class="flex flex-col border border-line-2 bg-surface-frame">
        <div class="flex items-end gap-px bg-line-1 px-[3px] pt-[3px]">
          {
            tabs.map((tab) => (
              <div
                class:list={[
                  'flex items-center gap-[3px] border-x border-t border-line-2 px-[5px] py-[3px]',
                  tab.active ? 'bg-surface-control' : 'bg-surface-frame',
                ]}
              >
                <span
                  class:list={[
                    'h-[4px] w-[4px] shrink-0',
                    tab.active ? 'bg-accent' : 'bg-ink-4/60',
                  ]}
                />
                <div
                  class:list={[
                    'h-[2px]',
                    tab.active ? 'bg-ink-2/55' : 'bg-ink-4/40',
                  ]}
                  style={`width:${tab.title}px`}
                />
                {tab.active && <span class="text-[7px] text-ink-4">×</span>}
              </div>
            ))
          }
          <span class="pb-[3px] pl-[3px] text-[9px] text-ink-4">+</span>
        </div>
        <div
          class="flex items-center gap-s2 border-b border-line-1 bg-surface-control px-s2 py-1"
        >
          <span class="text-[8px] text-ink-3">←</span>
          <span class="text-[8px] text-ink-4/60">→</span>
          <span class="text-[8px] text-ink-3">↻</span>
          <div
            class="flex min-w-0 flex-1 items-center border border-line-2 bg-surface-frame px-s2 py-[2px]"
          >
            <div class="h-[2px] w-24 bg-ink-3/40"></div>
          </div>
          <span class="text-[9px] text-ink-3">⋮</span>
        </div>
        {
          /* Real Hacker News has no dark mode — it's always its own cream
           page under whatever chrome is around it. The rest of this mock
           is our dark UI; this one surface deliberately isn't, because
           that's what the actual site looks like, tiled or not. */
        }
        <div class="flex flex-col bg-[#f6f6ef]">
          <div class="flex items-center gap-s2 bg-accent px-s2 py-[3px]">
            <span
              class="font-display text-[10px] font-semibold text-accent-ink"
            >
              Y
            </span>
            <div class="h-[3px] w-10 bg-accent-ink/45"></div>
            <div class="ml-auto h-[2px] w-14 bg-accent-ink/30"></div>
          </div>
          <div class="flex flex-col">
            {
              feedRows.map((row) => (
                <div class="flex items-center gap-s2 border-b border-black/10 px-s2 py-[5px] tight:py-1">
                  <span class="shrink-0 text-[8px] text-black/45">▲</span>
                  <div class="flex min-w-0 flex-1 flex-col gap-[3px]">
                    <div
                      class="h-[3px] bg-black/55"
                      style={`width:${row.title}%`}
                    />
                    <div
                      class="h-[2px] bg-black/30"
                      style={`width:${row.meta}%`}
                    />
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // The visitor's own real clock — the one thing in the mock that is
  // genuinely live, not a picture of liveness. See CLAUDE.md / the demo
  // handoff: everything else in this schematic is static on purpose.
  function tick(): void {
    const now = new Date()
    const text =
      String(now.getHours()).padStart(2, '0') +
      ':' +
      String(now.getMinutes()).padStart(2, '0')
    for (const el of document.querySelectorAll<HTMLElement>('[data-clock]')) {
      el.textContent = text
    }
  }
  tick()
  setInterval(tick, 1000)
</script>

<style>
  /* Only the active anchor's edge is reserved — DemoColumn's script keeps
     [data-screen]'s data-active-anchor in sync with whichever strip just
     entered (see its `show()`). No `top` case here any more — the
     top-anchored example reserves nothing in the tiled area, since it's
     the workspace bar above that shows it, not a strip down here (see the
     markup comment by the PanelPositionStrip loop). The transition reads
     as a real WM reflowing the tiled area when a bar appears on a
     different edge, not motion for its own sake: i3/sway do this too,
     they just don't animate it. Sizes match each anchor's own strip
     thickness in PanelPositionStrip.astro. */
  [data-gap-root] {
    padding: 0;
    transition: padding 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
    /* Fills [data-screen]'s remaining column space once the workspace bar
       (below) collapses, rather than leaving a gap where it used to
       reserve height. */
    display: flex;
    flex: 1;
    flex-direction: column;
  }
  [data-screen][data-active-anchor='right'] [data-gap-root] {
    padding-right: 14px;
  }
  [data-screen][data-active-anchor='left'] [data-gap-root] {
    padding-left: 14px;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-gap-root] {
      transition: none;
    }
  }

  /* The workspace/clock bar only has anything to show for the top-anchored
     example — see the markup comment above [data-top-bar]. `display`, not
     `visibility`: reserving its row's height for an example that never
     declared a bar there is exactly the dead-space problem the gap-reset
     fix above already solved once for the panel-position strip; the row
     actually collapses, and the flex-1/stretch chain below (.relative,
     then its grid) is what lets the tiled area grow to fill the space
     that opens up instead of leaving it blank. */
  [data-screen]:not([data-active-anchor='top']) [data-top-bar] {
    display: none;
  }

  /* A real screenshot has fixed pixel dimensions — a monitor doesn't
     resize itself. box-sizing: border-box is what makes that compatible
     with both the padding above and the workspace bar collapsing: they
     eat into (or free up, respectively) this fixed box rather than
     resizing it, so cycling through examples changes what's inside the
     screen, never the screen's own size. The number below is this mock's
     own natural rendered size with the bar showing — the tallest case, so
     nothing else needs more. */
  [data-screen] {
    box-sizing: border-box;
    width: 560px;
    height: 243px;
    display: flex;
    flex-direction: column;
  }

  /* The other half of the stretch chain above: [data-gap-root]'s own
     single grid row (the tiled panes) fills whatever height it was given
     — CSS Grid's default stretch alignment for an auto-sized track with
     room to spare, not a fixed pane height in disguise. */
  [data-gap-root] > .grid {
    flex: 1;
  }
</style>
