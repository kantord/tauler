---
// The install line: a dark field with an accent prompt glyph.
interface Props {
  prompt?: string
}

const { prompt = '$' } = Astro.props
---

<div
  class="above-fold max-w-[460px] border border-line-1 bg-surface-control px-5 py-s4 font-ui text-chrome text-ink-1 short:px-s4 short:py-s3"
>
  <span class="text-accent">{prompt}</span>{' '}
  <slot />
</div>
