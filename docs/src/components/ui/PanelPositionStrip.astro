---
// One anchor-edge strip in ScreenMock's panel-position preview. `top`,
// `right` and `left` share the same wrapper/hidden-guard shell — only the
// position/size classes and the inner layout direction differ per anchor —
// so that shell lives here once; each anchor's own glyph markup is the
// caller's problem, passed through the default slot.
//
// `hidden` has to sit alone on this wrapper: paired with a `flex`/`grid`
// utility on the *same* element, the browser's default `[hidden] {
// display: none }` and Tailwind's `.flex { display: flex }` land at equal
// specificity, and whichever the stylesheet happens to define later wins —
// silently, with every strip shown at once. Layout stays on the inner div
// so `hidden` never has to win that tie.
interface Props {
  id: string
  hidden: boolean
  anchor: 'top' | 'right' | 'left'
}

const { id, hidden, anchor } = Astro.props

const WRAPPER_CLASS = {
  top: 'absolute inset-x-0 top-0 h-[8px] bg-accent',
  right: 'absolute inset-y-0 right-0 w-[14px] bg-accent',
  left: 'absolute inset-y-0 left-0 w-[14px] bg-accent',
} as const

const INNER_CLASS = {
  top: 'flex h-full items-center gap-[3px] px-[3px]',
  right: 'flex h-full flex-col items-center justify-center gap-[3px]',
  left: 'flex h-full flex-col justify-center gap-[3px] p-[3px]',
} as const
---

<div data-demo-frame={id} hidden={hidden} class={WRAPPER_CLASS[anchor]}>
  <div class={INNER_CLASS[anchor]}>
    <slot />
  </div>
</div>
