---
// Direct access into the demo cycle — square marks, never round (radius 0
// is the whole visual argument). DemoColumn's script drives the actual
// cycling; this only renders the buttons and the label it updates.
interface Props {
  states: { id: string; label: string }[]
}

const { states } = Astro.props
---

<div class="flex items-center gap-s4 px-s2">
  <span
    data-demo-label
    class="font-ui text-label-sm tracking-chrome text-ink-4"
  >
    {states[0]?.label}
  </span>
  <div class="ml-auto flex items-center gap-s3">
    {
      states.map((s, i) => (
        <button
          type="button"
          data-demo-dot
          data-state-id={s.id}
          data-label={s.label}
          aria-current={i === 0 ? 'true' : undefined}
          aria-label={`Show the ${s.label.toLowerCase()} example`}
          class="h-[7px] w-[7px] cursor-pointer border border-line-2 bg-transparent transition hover:border-ink-3 aria-current:border-accent aria-current:bg-accent"
        />
      ))
    }
  </div>
</div>
