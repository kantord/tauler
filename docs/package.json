{
  "name": "docs",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run build:css && pnpm run build:d3 && next build",
    "build:css": "tailwindcss -i .tauler/tailwind.css -o public/tauler/tauler.css && node scripts/check-classes.mjs",
    "build:d3": "cp node_modules/d3/dist/d3.min.js public/tauler/d3.min.js",
    "test": "playwright test",
    "test:docker": "bash scripts/update-snapshots.sh",
    "test:update": "bash scripts/update-snapshots.sh --update",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "next typegen && tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "validate:html": "html-validate 'dist/**/*.html'",
    "checks": "pnpm run format:check && pnpm run lint && pnpm run check && pnpm run build && pnpm run validate:html && DOCS_PREBUILT=1 playwright test tests/console.spec.ts --project=desktop"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.1",
    "d3": "7.9.0",
    "fumadocs-core": "16.17.9",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.9",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-directive": "4.0.0",
    "simple-icons": "16.36.0",
    "three": "0.185.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.185.1",
    "html-validate": "11.16.4",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "postcss": "^8.5.31",
    "shiki": "4.5.0",
    "sirv-cli": "3.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
