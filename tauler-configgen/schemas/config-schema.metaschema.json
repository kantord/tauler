{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tauler.dev/schemas/config-schema.metaschema.json",
  "$defs": {
    "propRule": {
      "type": "object",
      "properties": {
        "pattern": { "type": "string" },
        "enum": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "error": { "type": "string" },
        "items": { "$ref": "#/$defs/propRule" }
      }
    }
  },
  "type": "object",
  "required": ["nodes"],
  "properties": {
    "nodes": {
      "type": "array",
      "minItems": 1,
      "contains": { "properties": { "root": { "const": true } }, "required": ["root"] },
      "minContains": 1,
      "maxContains": 1,
      "items": {
        "type": "object",
        "required": ["component"],
        "properties": {
          "component": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
          "root": { "type": "boolean" },
          "container": { "type": "boolean" },
          "children_as": { "type": "string" },
          "props": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/propRule" }
          },
          "constants": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        },
        "if": { "properties": { "container": { "const": true } }, "required": ["container"] },
        "then": { "required": ["children_as"] }
      }
    }
  }
}
