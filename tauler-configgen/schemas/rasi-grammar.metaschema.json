{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tauler.dev/schemas/rasi-grammar.metaschema.json",
  "type": "object",
  "required": ["grammar", "component", "selectors"],
  "properties": {
    "grammar": { "const": "rasi" },
    "component": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
    "selectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "component", "properties"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-zA-Z*][a-zA-Z0-9_-]*$" },
          "component": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
          "properties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "component"],
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
                "component": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
                "pattern": { "type": "string" },
                "enum": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
              }
            }
          }
        }
      }
    }
  }
}
